{
  "name": "the-agent-became-me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "node scripts/fetch-openfoodfacts.mjs",
    "experiment": "tsx scripts/generate-baseline.ts",
    "webarena:fetch": "node scripts/fetch-webarena-metadata.mjs",
    "webarena:pilot": "tsx scripts/run-webarena-pilot.ts",
    "webarena:evaluate": "node scripts/evaluate-webarena-experiment.mjs",
    "webarena:failure": "tsx scripts/run-webarena-failure-experiment.ts",
    "webarena:failure:evaluate": "node scripts/evaluate-webarena-failure-experiment.mjs",
    "amazon:controlled": "tsx scripts/run-amazon-controlled-layer.ts",
    "amazon:evaluate": "node scripts/evaluate-amazon-field-probe.mjs",
    "amazon:evidence": "node scripts/prepare-amazon-evidence.mjs",
    "cross-task:run": "tsx scripts/run-cross-task-exposure.ts",
    "cross-task:evaluate": "node scripts/evaluate-cross-task-exposure.mjs",
    "sensitivity:run": "tsx scripts/run-cross-task-sensitivity.ts",
    "sensitivity:evaluate": "node scripts/evaluate-cross-task-sensitivity.mjs",
    "external:data": "node scripts/fetch-movielens-100k.mjs",
    "external:run": "tsx scripts/run-external-validity.ts",
    "external:evaluate": "node scripts/evaluate-external-validity.mjs",
    "amazon:sasrec:data": "node scripts/fetch-amazon-luxury-beauty.mjs",
    "amazon:sasrec:run": "node scripts/run-amazon-sasrec.mjs",
    "amazon:sasrec:evaluate": "node scripts/evaluate-amazon-sasrec.mjs",
    "amazon:cross-category:data": "node scripts/fetch-amazon-cross-category.mjs",
    "amazon:cross-category:run": "node scripts/run-amazon-cross-category.mjs",
    "amazon:cross-category:evaluate": "node scripts/evaluate-amazon-cross-category.mjs",
    "delegate:run": "node scripts/run-delegated-activation.mjs",
    "delegate:evaluate": "node scripts/evaluate-delegated-activation.mjs",
    "online:pilot": "node scripts/run-online-storefront-pilot.mjs",
    "online:evaluate": "node scripts/evaluate-online-storefront-pilot.mjs",
    "online:v2:run": "node scripts/run-online-storefront-v2.mjs",
    "online:v2:evaluate": "node scripts/evaluate-online-storefront-v2.mjs",
    "online:model-robustness:run": "node scripts/run-online-storefront-model-robustness.mjs",
    "online:model-robustness:evaluate": "node scripts/evaluate-online-storefront-model-robustness.mjs",
    "online:llm:dry-run": "node scripts/run-online-storefront-llm-pilot.mjs",
    "online:llm:pilot": "node scripts/run-online-storefront-llm-pilot.mjs --execute",
    "online:llm:evaluate": "node scripts/evaluate-online-storefront-llm-pilot.mjs",
    "online:cross-llm:dry-run:mimo": "node scripts/run-online-storefront-cross-llm-pilot.mjs --provider mimo",
    "online:cross-llm:dry-run:deepseek": "node scripts/run-online-storefront-cross-llm-pilot.mjs --provider deepseek",
    "online:cross-llm:run:mimo": "node scripts/run-online-storefront-cross-llm-pilot.mjs --provider mimo --execute",
    "online:cross-llm:run:deepseek": "node scripts/run-online-storefront-cross-llm-pilot.mjs --provider deepseek --execute",
    "online:cross-llm:evaluate:mimo": "node scripts/evaluate-online-storefront-cross-llm-pilot.mjs --provider mimo",
    "online:cross-llm:evaluate:deepseek": "node scripts/evaluate-online-storefront-cross-llm-pilot.mjs --provider deepseek",
    "paper:figures": "node scripts/generate-paper-figures.mjs",
    "verify:artifacts": "tsx scripts/verify-artifacts.ts",
    "qa:site": "node scripts/qa-site.mjs",
    "qa:storefront": "node scripts/qa-online-storefront.mjs",
    "qa:storefront-v2": "node scripts/qa-online-storefront-v2.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm verify:artifacts && pnpm amazon:evaluate && pnpm cross-task:evaluate && pnpm sensitivity:evaluate && pnpm external:evaluate && pnpm amazon:sasrec:evaluate && pnpm amazon:cross-category:evaluate && pnpm delegate:evaluate && pnpm online:evaluate && pnpm online:v2:evaluate && pnpm online:model-robustness:evaluate && pnpm online:llm:evaluate && pnpm online:cross-llm:evaluate:mimo && pnpm online:cross-llm:evaluate:deepseek && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "d3": "^7.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "fast-check": "^4.3.0",
    "jsdom": "^27.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "packageManager": "pnpm@11.9.0"
}
